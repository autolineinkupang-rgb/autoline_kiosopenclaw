# ==============================================
# TEMPLATE .env — AMAN UNTUK GITHUB
# Copy file ini ke .env dan isi valuenya
# ==============================================

GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE
GEMINI_API_KEY=AIza_YOUR_GEMINI_KEY_HERE

SIGNAL_PHONE_NUMBER=+62XXXXXXXXXXX
SIGNAL_RECIPIENT=+62XXXXXXXXXXX
SIGNAL_CLI_PATH=/usr/local/bin/signal-cli

KV_URL=redis://your-kv-url
KV_REST_API_URL=https://your-kv.kv.vercel-storage.com
KV_REST_API_TOKEN=your_token_here
KV_REST_API_READ_ONLY_TOKEN=your_read_only_token

KIOS_NAMA=Kios Desa Maju
KIOS_TIMEZONE=Asia/Makassar
OMZET_TARGET_HARIAN=500000

CCTV_URL=rtsp://admin:password@192.168.1.100:554/stream
CCTV_ENABLED=false

BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC=https://polygon-rpc.com

NODE_ENV=production
